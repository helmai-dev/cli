#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

printf '==> Checking Node.js toolchain\n'
node_major="$(node --version | sed -E 's/^v([0-9]+).*/\1/')"
if (( node_major < 18 )); then
  printf 'Node.js 18 or newer is required (found %s).\n' "$(node --version)" >&2
  exit 1
fi
npm --version

printf '==> Installing locked npm dependencies\n'
time npm ci

printf '==> Building the CLI\n'
time npm run build
